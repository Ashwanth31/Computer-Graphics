import pygame
 
pygame.init()
screen = pygame.display.set_mode((800, 600))
pygame.display.set_caption("DDA Line Drawing")
 
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
 
 
def dda(x1, y1, x2, y2):
    dx = x2 - x1
    dy = y2 - y1
    steps = max(abs(dx), abs(dy))
 
    if steps == 0:
        pygame.draw.rect(screen, BLACK, (round(x1), round(y1), 3, 3))
        return
 
    x_inc = dx / steps
    y_inc = dy / steps
 
    x, y = x1, y1
 
    for i in range(steps + 1):
        pygame.draw.rect(screen, BLACK, (round(x), round(y), 3, 3))
        x += x_inc
        y += y_inc
 
 
running = True
while running:
    screen.fill(WHITE)
    dda(100, 100, 700, 500)
    pygame.display.update()
 
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
 
pygame.quit()
