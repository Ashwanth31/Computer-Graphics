import pygame
 
pygame.init()
screen = pygame.display.set_mode((800, 600))
pygame.display.set_caption("Line Clipping Algorithms")
 
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 0, 0)
BLUE = (0, 0, 255)
GREEN = (0, 180, 0)
 
xmin, ymin = 200, 150
xmax, ymax = 600, 450
 
LEFT, RIGHT, BOTTOM, TOP = 1, 2, 4, 8
 
 
def region_code(x, y):
    code = 0
    if x < xmin:
        code |= LEFT
    elif x > xmax:
        code |= RIGHT
    if y < ymin:
        code |= TOP
    elif y > ymax:
        code |= BOTTOM
    return code
 
 
def cohen_sutherland(x1, y1, x2, y2):
    c1 = region_code(x1, y1)
    c2 = region_code(x2, y2)
 
    while True:
        if c1 == 0 and c2 == 0:
            return x1, y1, x2, y2
        if c1 & c2:
            return None
 
        code = c1 if c1 != 0 else c2
 
        if code & TOP:
            x = x1 + (x2 - x1) * (ymin - y1) / (y2 - y1)
            y = ymin
        elif code & BOTTOM:
            x = x1 + (x2 - x1) * (ymax - y1) / (y2 - y1)
            y = ymax
        elif code & RIGHT:
            y = y1 + (y2 - y1) * (xmax - x1) / (x2 - x1)
            x = xmax
        else:  # LEFT
            y = y1 + (y2 - y1) * (xmin - x1) / (x2 - x1)
            x = xmin
 
        if code == c1:
            x1, y1 = x, y
            c1 = region_code(x1, y1)
        else:
            x2, y2 = x, y
            c2 = region_code(x2, y2)
 
 
def liang_barsky(x1, y1, x2, y2):
    dx, dy = x2 - x1, y2 - y1
 
    p = [-dx, dx, -dy, dy]
    q = [x1 - xmin, xmax - x1, y1 - ymin, ymax - y1]
 
    t1, t2 = 0, 1
 
    for pi, qi in zip(p, q):
        if pi == 0:
            if qi < 0:
                return None
        else:
            t = qi / pi
            if pi < 0:
                t1 = max(t1, t)
            else:
                t2 = min(t2, t)
 
    if t1 > t2:
        return None
 
    return (
        x1 + t1 * dx, y1 + t1 * dy,
        x1 + t2 * dx, y1 + t2 * dy
    )
 
 
x1, y1 = 100, 100
x2, y2 = 700, 500
 
running = True
while running:
    screen.fill(WHITE)
 
    # clipping window
    pygame.draw.rect(
        screen, BLACK,
        (xmin, ymin, xmax - xmin, ymax - ymin), 2
    )
 
    # original line
    pygame.draw.line(screen, RED, (x1, y1), (x2, y2), 2)
 
    # Cohen-Sutherland result
    r1 = cohen_sutherland(x1, y1, x2, y2)
    if r1:
        pygame.draw.line(
            screen, BLUE,
            (round(r1[0]), round(r1[1])),
            (round(r1[2]), round(r1[3])), 5
        )
 
    # Liang-Barsky result
    r2 = liang_barsky(x1, y1, x2, y2)
    if r2:
        pygame.draw.line(
            screen, GREEN,
            (round(r2[0]), round(r2[1])),
            (round(r2[2]), round(r2[3])), 2
        )
 
    pygame.display.update()
 
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
 
pygame.quit()
