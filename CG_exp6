import pygame
 
pygame.init()
screen = pygame.display.set_mode((800, 600))
pygame.display.set_caption("Bresenham Line Drawing")
 
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
 
 
def bresenham(x1, y1, x2, y2):
    dx = abs(x2 - x1)
    dy = abs(y2 - y1)
 
    sx = 1 if x1 < x2 else -1
    sy = 1 if y1 < y2 else -1
 
    error = dx - dy
 
    while True:
        pygame.draw.rect(screen, BLACK, (x1, y1, 3, 3))
 
        if x1 == x2 and y1 == y2:
            break
 
        e2 = 2 * error
 
        if e2 > -dy:
            error -= dy
            x1 += sx
 
        if e2 < dx:
            error += dx
            y1 += sy
 
 
running = True
while running:
    screen.fill(WHITE)
    bresenham(100, 100, 700, 500)
    pygame.display.update()
 
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
 
pygame.quit()
